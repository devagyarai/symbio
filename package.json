{
  "name": "symbio-monorepo",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.js",
    "verify": "node scripts/verify.js",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate --",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "db:seed": "turbo run db:seed",
    "db:reset": "pnpm --filter database exec prisma migrate reset",
    "db:health": "node scripts/db-health.js",
    "test:env": "turbo run test:env",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=15",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.12.1",
    "husky": "^8.0.0",
    "imagetracerjs": "^1.2.6",
    "jimp": "^1.6.1",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "puppeteer": "^25.3.0",
    "turbo": "latest"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
