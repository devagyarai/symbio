{
  "name": "database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "config": "workspace:*",
    "logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint-config": "workspace:*",
    "prisma": "^5.17.0",
    "tsconfig": "workspace:*",
    "tsx": "^3.14.0",
    "typescript": "^5.2.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
