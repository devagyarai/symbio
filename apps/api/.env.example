# Symbio API Environment Variables
# API specific variables

# --- Server ---
PORT="4000"
HOST="0.0.0.0"
API_VERSION="v1"

# --- Security ---
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# --- Logging ---
LOG_LEVEL="debug" # debug, info, warn, error, fatal
LOG_PRETTY="true" # true in dev, false in prod
